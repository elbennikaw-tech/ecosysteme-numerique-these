@article{severino_low-dose_2002,
	title = {Low-dose dexamethasone in the rat: a model to study insulin resistance},
	volume = {283},
	issn = {0193-1849, 1522-1555},
	shorttitle = {Low-dose dexamethasone in the rat},
	url = {https://www.physiology.org/doi/10.1152/ajpendo.00185.2001},
	doi = {10.1152/ajpendo.00185.2001},
	abstract = {The main aim of this study was to set up a new animal model to study insulin resistance. Wistar rats (6 or 7 per group) received the following for 4 wk in experiment 1: 1) vehicle, 2) 2 μg/day subcutaneous dexamethasone, 3) metformin (400 mg · kg
              −1
              · day
              −1
              os), and 4) dexamethasone plus metformin. In experiment 2the rats received the following: 1) vehicle, 2) dexamethasone, 3) dexamethasone plus arginine (2\%; as substrate of the nitric oxide synthase for nitric oxide production) in tap water, and 4) dexamethasone plus isosorbide dinitrate (70 mg/kg; as direct nitric oxide donor) in tap water. Insulin sensitivity was significantly reduced by dexamethasone already at week 1, before the increase in blood pressure ( day 15) and without significant changes in body weight compared with vehicle. Dexamethasone-treated rats had significantly higher triglycerides, hematocrit, and insulin, whereas serum total nitrates/ nitrites were lower compared with vehicle. The concomitant treatment with metformin minimized all the described effects of dexamethasone. In experiment 2, only isosorbide dinitrate was able to prevent the observed dexamethasone-induced metabolic, hemodynamic, and insulin sensitivity changes. Chronic low-dose subcutaneous dexamethasone (2 μg/day) is a useful model to study the relationships between insulin resistance and blood pressure in the rat, and dexamethasone might decrease insulin sensitivity and increase blood pressure through an endothelium-mediated mechanism.},
	language = {en},
	number = {2},
	urldate = {2026-11-15},
	journal = {American Journal of Physiology-Endocrinology and Metabolism},
	author = {Severino, C. and Brizzi, P. and Solinas, A. and Secchi, G. and Maioli, M. and Tonolo, G.},
	month = aug,
	year = {2002},
	pages = {E367--E373},
	file = {PDF:files/185/Severino et al. - 2002 - Low-dose dexamethasone in the rat a model to study insulin resistance.pdf:application/pdf},
}
